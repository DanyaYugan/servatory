# Параметры установки из Docker Hub.
# Скопируйте в .env и поправьте под сервер.

# образ и версия
SERVATORY_IMAGE=danyayugan/servatory:0.2.0-beta

# порт панели
SERVATORY_PORT=8090

# группа Docker на хосте: stat -c '%g' /var/run/docker.sock
DOCKER_GID=112

# debug | info | warning | error
SERVATORY_LOG_LEVEL=info
