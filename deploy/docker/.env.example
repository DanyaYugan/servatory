# Servatory — пример окружения для Docker.
# Логин, пароль и порт хранятся в config.toml внутри тома /data.
# Здесь только то, что удобно менять при запуске.

# порт панели: должен совпадать с ports в compose
SERVATORY_PORT=8090

# группа Docker на хосте (stat -c '%g' /var/run/docker.sock)
DOCKER_GID=112

# каталог состояния внутри контейнера
SERVATORY_DATA=/data


# debug | info | warning | error
SERVATORY_LOG_LEVEL=info
